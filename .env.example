# Supabase project URL (bare domain, no /rest/v1/) and publishable key — never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# PaceTasks Pro: RevenueCat's public Apple API key (appl_...). Without it the app runs, but Pro can't be bought.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
