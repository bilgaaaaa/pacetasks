# Supabase project URL (bare domain, no /rest/v1/) and publishable key — never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# RevenueCat public iOS SDK key (appl_...), for PaceTasks Pro. Without it Pro is unlocked for everyone, so
# set it on EAS before any App Store release: eas env:create --environment production --name EXPO_PUBLIC_REVENUECAT_IOS_KEY ...
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
