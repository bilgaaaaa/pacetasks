{
  "name": "pacetasks",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:demo": "EXPO_PUBLIC_DEMO_MODE=1 expo start --web",
    "web:demo:export": "EXPO_PUBLIC_DEMO_MODE=1 expo export --platform web --output-dir e2e/output/web",
    "ios:testflight": "npx -y eas-cli@latest build --platform ios --profile testflight --auto-submit",
    "ios:release": "npx -y eas-cli@latest build --platform ios --profile production --auto-submit",
    "ios:preview": "npx -y eas-cli@latest build --platform ios --profile preview",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:test": "supabase test db",
    "e2e": "npm run web:demo:export && node e2e/todayJourney.mjs",
    "site:screens": "npm run web:demo:export && node e2e/siteScreens.mjs",
    "verify": "npm run typecheck && npm test && npm run e2e"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.8",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "10.12.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "playwright": "^1.56.0",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.globalSetup.js",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/supabase/functions/_shared/domain/$1",
      "^@server/(.*)$": "<rootDir>/supabase/functions/_shared/server/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/functions/(?!_shared/domain/)"
    ]
  }
}
