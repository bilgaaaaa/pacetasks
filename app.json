{
  "expo": {
    "name": "PaceTasks",
    "slug": "pacetasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pacetasks.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pacetasks.app"
        ]
      },
      "appleTeamId": "835R3WR9AL"
    },
    "android": {
      "package": "com.pacetasks.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#3F7446"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#E7EFE1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141A16"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3F7446"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "PaceTasks shows today's calendar events in the Deskfocus widget.",
          "remindersPermission": "PaceTasks shows today's reminders in the Deskfocus widget and checks them off when you do."
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "4b7e2dbc-8401-4288-85fc-bbb367fc9296"
      }
    },
    "owner": "bilgaaaa"
  }
}
