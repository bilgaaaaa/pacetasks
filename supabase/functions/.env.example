# Secrets for `npx supabase functions serve --env-file supabase/functions/.env` (local only).
# In production set the same names with `npx supabase secrets set NAME=value`. Never commit real keys.
AI_PROVIDER=anthropic
AI_MODEL_BRAIN_DUMP=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAIN_DUMP_DAILY_LIMIT=30
# PaceTasks Pro (RevenueCat). The secret key is RevenueCat's "Secret API key" (sk_...), never the app's public one.
REVENUECAT_SECRET_API_KEY=
# Any long random string; type the same value into RevenueCat → Integrations → Webhooks → Authorization header.
REVENUECAT_WEBHOOK_AUTH=
